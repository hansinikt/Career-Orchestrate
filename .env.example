# Copy to .env (never commit .env). No real secrets in this file. Every variable is optional: the app runs with none of them.
APP_MODE=replay                    # replay (default, no keys needed) | live (only after an LLM provider is tested)
DB_PATH=./app.db                   # SQLite file. USER DATA ONLY
CORS_ORIGINS=*                     # dev default. Demo on one laptop serving frontend_dist needs no CORS
ALLOW_UNVERIFIED_RESOURCES=true    # show seed_unverified courses WITH a visible "not verified" badge
ALLOW_SAMPLE_RESOURCES=true        # show sample_placeholder courses WITH a visible "sample" badge; set false once verified courses exist
# --- reserved for the optional LLM adapter (PRD section 10). Leave empty until tested. ---
LLM_PROVIDER=                      # replay | sap_genai_hub | anthropic | openai | gemini
LLM_MODEL=
LLM_API_KEY=
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
